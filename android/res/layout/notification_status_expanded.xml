<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
        <TextView android:id="@+id/pending_count" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="当日待办" android:textColor="#25333D" android:textSize="17sp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:contentDescription="查看当日待办"/>
        <TextView android:id="@+id/done_count" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="当日完成" android:textColor="#25333D" android:textSize="17sp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:contentDescription="查看当日完成"/>
    </LinearLayout>
    <TextView android:id="@+id/status_detail" android:layout_width="match_parent" android:layout_height="28dp" android:text="今日专注" android:textColor="#526675" android:textSize="12sp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/task_title" android:layout_width="match_parent" android:layout_height="24dp" android:textSize="13sp" android:textColor="#25333D" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <TextView android:id="@+id/add_task" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+ 添加" android:textColor="#137F72" android:textSize="14sp" android:gravity="center" android:maxLines="1" android:contentDescription="添加任务"/>
        <TextView android:id="@+id/toggle_ball" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="O 显示" android:textColor="#137F72" android:textSize="14sp" android:gravity="center" android:maxLines="1" android:contentDescription="显示或隐藏悬浮球"/>
        <TextView android:id="@+id/open_timer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:text="番茄钟" android:textColor="#137F72" android:textSize="13sp" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:contentDescription="打开番茄钟"/>
        <TextView android:id="@+id/timer_control" android:layout_width="48dp" android:layout_height="match_parent" android:text="暂停" android:textColor="#137F72" android:textSize="14sp" android:gravity="center" android:maxLines="1" android:visibility="gone" android:contentDescription="暂停计时"/>
        <TextView android:id="@+id/tool_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="设置" android:textColor="#526675" android:textSize="14sp" android:gravity="center" android:maxLines="1" android:contentDescription="通知栏和悬浮球设置"/>
    </LinearLayout>
</LinearLayout>
