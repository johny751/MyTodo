static void work_completion(J *record,J *old){int done=!strcmp(str(record,"status"),"completed"),was=old&&!strcmp(str(old,"status"),"completed");if(done&&!was&&!*str(record,"completedAt")){char stamp[40];now(stamp);ss(record,"completedAt",stamp);}else if(!done&&was)ss(record,"completedAt","");}
