typedef struct {int kind;int64_t millis;char day[11];} WorkTime;
static int decimal_part(const char *text,int start,int count){int value=0;for(int i=0;i<count;i++){char c=text[start+i];if(c<'0'||c>'9')return -1;value=value*10+c-'0';}return value;}
static WorkTime work_time(const char *text){
