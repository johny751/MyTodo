static J *stable_steps(const char *text,J *old){
 J *names=cJSON_CreateArray(),*steps=cJSON_CreateArray();char *copy=_strdup(text),*context=0,*line=strtok_s(copy,"\r\n",&context);while(line){while(*line==' '||*line=='\t')line++;size_t length=strlen(line);while(length&&(line[length-1]==' '||line[length-1]=='\t'))line[--length]=0;if(*line){J *name=cJSON_CreateObject();ss(name,"name",line);cJSON_AddItemToArray(names,name);}line=strtok_s(0,"\r\n",&context);}free(copy);
