static void work_preserve_text(J *record,J *old,const char *key){if(old&&cJSON_IsString(get(record,key))&&!strcmp(str(record,key),str(old,key))){J *previous=get(old,key);if(previous)set(record,key,dup(previous));else cJSON_DeleteItemFromObjectCaseSensitive(record,key);}}
static char *work_choice_prepare(J *draft,const char *key,const char *base,const char *fallback,int creating){
 char input[80],original[80];snprintf(input,sizeof(input),"%sChoice",key);snprintf(original,sizeof(original),"%sOriginalChoice",key);const char *current=str(draft,key);char *label=0;if(creating&&!*current)label=_strdup(fallback);else if(*current&&d408_choice(current,base))label=_strdup(current);else{char *raw=work_time_original(draft,key);size_t size=strlen(raw)+80;label=calloc(size,1);snprintf(label,size,"保留原值：%s",get(draft,key)?*raw?raw:"空文本":"未设置");free(raw);for(char *p=label;*p;p++)if(*p=='|'||*p=='\r'||*p=='\n')*p=' ';}ss(draft,input,label);ss(draft,original,label);size_t size=strlen(base)+strlen(label)+2;char *options=calloc(size,1);strcpy(options,base);if(!d408_choice(label,base)){strcat(options,"|");strcat(options,label);}free(label);return options;
