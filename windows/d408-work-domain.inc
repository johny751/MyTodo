 if(text[position]=='Z'){offset=0;position++;}else if(text[position]=='+'||text[position]=='-'){if(length!=(size_t)position+6||text[position+3]!=':')return out;int h=decimal_part(text,position+1,2),m=decimal_part(text,position+4,2);if(h<0||h>23||m<0||m>59)return out;offset=(h*60+m)*(text[position]=='-'?-1:1);position+=6;}if(position!=(int)length)return out;
 SYSTEMTIME system={0};system.wYear=(WORD)decimal_part(text,0,4);system.wMonth=(WORD)decimal_part(text,5,2);system.wDay=(WORD)decimal_part(text,8,2);system.wHour=(WORD)hour;system.wMinute=(WORD)minute;system.wSecond=(WORD)second;system.wMilliseconds=(WORD)millisecond;FILETIME file;if(!SystemTimeToFileTime(&system,&file))return out;ULARGE_INTEGER raw;raw.LowPart=file.dwLowDateTime;raw.HighPart=file.dwHighDateTime;out.millis=(int64_t)(raw.QuadPart/10000)-11644473600000LL-(int64_t)offset*60000;char local[40];format_ms(out.millis,local);memcpy(out.day,local,10);out.day[10]=0;out.kind=3;return out;
}
static char *work_time_original(J *record,const char *key){J *value=get(record,key);return !value?_strdup(""):cJSON_IsString(value)?_strdup(str(record,key)):json(value);}
