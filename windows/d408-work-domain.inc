static int work_choice_collect(J *record,J *old,const char *key,const char *base){char input[80],original[80];snprintf(input,sizeof(input),"%sChoice",key);snprintf(original,sizeof(original),"%sOriginalChoice",key);int ok=1;if(old&&!strcmp(str(record,input),str(record,original))){if(get(old,key))set(record,key,dup(get(old,key)));else cJSON_DeleteItemFromObjectCaseSensitive(record,key);}else if(d408_choice(str(record,input),base))ss(record,key,str(record,input));else ok=0;cJSON_DeleteItemFromObjectCaseSensitive(record,input);cJSON_DeleteItemFromObjectCaseSensitive(record,original);return ok;}
static int work_color_valid(const char *value){return !*value||(strlen(value)==7&&value[0]=='#'&&strspn(value+1,"0123456789abcdefABCDEF")==6);}
static int work_contains(const char *text,const char *query){if(!*query)return 1;wchar_t *haystack=wide(text),*needle=wide(query);size_t length=wcslen(haystack),wanted=wcslen(needle);int found=0;if(wanted<=length)for(size_t i=0;i+wanted<=length;i++)if(CompareStringOrdinal(haystack+i,(int)wanted,needle,(int)wanted,TRUE)==CSTR_EQUAL){found=1;break;}free(haystack);free(needle);return found;}
