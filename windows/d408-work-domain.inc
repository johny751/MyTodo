typedef struct {int total,completed,cancelled,overdue,waiting;double rate;} WorkStats;
static int work_stats_range(const char *from,const char *to){return date_valid(from)&&date_valid(to)&&(!*from||!*to||strcmp(from,to)<=0);}
static int work_template_deletable(J *state,J *template){J *instance;cJSON_ArrayForEach(instance,get(state,"instances"))if(!strcmp(str(instance,"accountId"),str(template,"accountId"))&&!strcmp(str(instance,"templateId"),str(template,"id"))){J *snapshot=get(instance,"templateSnapshot"),*step;if(!cJSON_IsObject(snapshot)||!cJSON_IsArray(get(snapshot,"steps"))||cJSON_GetArraySize(get(snapshot,"steps"))<1)return 0;cJSON_ArrayForEach(step,get(snapshot,"steps"))if(!cJSON_IsObject(step)||!cJSON_IsString(get(step,"name"))||!*str(step,"name"))return 0;}return 1;}
static WorkStats work_stats(J *state,const char *projectId,const char *from,const char *to,const char *query,const char *status,int64_t current){
